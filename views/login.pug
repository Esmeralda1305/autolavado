include layout/header

body.login-body

  .overlay

  // Ondas decorativas
  .wave
  .wave

  .login-box
    .logo.text-center
      img(src="/img/logo.png", alt="Logo Autolavado")

    h2 UTNACAR WASH

    form#loginForm
      .input-box
        input#user(type="text", placeholder="Usuario")

      .input-box
        input#pass(type="password", placeholder="Contraseña")

      button.login-btn(href="/registrodeservicio") Entrar

      //a.btn.btn-primary(href="/") Ir al inicio

      a.btn.btn-primary(href="/registrodeservicio") Ir a Servicios
      p#errorMsg.error Usuario o contraseña incorrectos