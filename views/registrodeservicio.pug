include layout/header

.container.py-5
  .row.justify-content-center
    .col-lg-8.col-md-10

      h2.titulo-principal.text-center.mb-2 Registro de Servicio - Auto Lavado 
      p.text-center.text-muted.mb-4 Aquí puedes registrar los servicios.

      .card.shadow-lg.p-4

        form.row.g-3(method="POST" action="/guardar")

          // DATOS CLIENTE
          h5.text-info.mt-2.mb-3 Datos del Cliente

          .col-md-6
            label.form-label(for="nombreCliente") Nombre del cliente
            input.form-control(
              type="text"
              id="nombreCliente"
              name="nombreCliente"
              required
            )

          .col-md-6
            label.form-label(for="telefonoCliente") Teléfono (WhatsApp)
            input.form-control(
              type="text"
              id="telefonoCliente"
              name="telefonoCliente"
              placeholder="Ej: 4491234567"
              required
            )

          // VEHICULO
          h5.text-info.mt-4.mb-3 Datos del Vehículo

          .col-md-4
            label.form-label(for="marcaVehiculo") Marca
            input.form-control(
              type="text"
              id="marcaVehiculo"
              name="marcaVehiculo"
              required
            )

          .col-md-4
            label.form-label(for="modeloVehiculo") Modelo
            input.form-control(
              type="text"
              id="modeloVehiculo"
              name="modeloVehiculo"
              required
            )

          .col-md-4
            label.form-label(for="anioVehiculo") Año
            input.form-control(
              type="number"
              id="anioVehiculo"
              name="anioVehiculo"
              required
            )

          .col-md-4
            label.form-label(for="colorVehiculo") Color
            input.form-control(
              type="text"
              id="colorVehiculo"
              name="colorVehiculo"
            )

          .col-md-4
            label.form-label(for="placasVehiculo") Placas
            input.form-control(
              type="text"
              id="placasVehiculo"
              name="placasVehiculo"
              required
            )

          .col-md-4
            label.form-label(for="tipoVehiculo") Tipo de vehículo
            select.form-select(
              id="tipoVehiculo"
              name="tipoVehiculo"
              required
            )
              option(value="" selected disabled) Seleccionar...
              option Auto
              option Camioneta
              option Moto
              option Otro

          // SERVICIO
          h5.text-info.mt-4.mb-3 Servicio solicitado

          .col-md-6
            label.form-label(for="servicio") Tipo de servicio
            select.form-select(
              id="servicio"
              name="servicio"
              required
            )
              option(value="" selected disabled) Seleccionar servicio...
              option Lavado básico
              option Lavado completo
              option Lavado con cera
              option Aspirado interior
              option Lavado de motor
              option Pulido / encerado

          .col-md-6
            label.form-label(for="precio") Precio
            input.form-control(
              type="number"
              id="precio"
              name="precio"
              required
            )

          // ESTADO
          h5.text-info.mt-4.mb-3 Estado del vehículo

          .col-md-6
            label.form-label(for="estadoVehiculo") Estado
            select.form-select(
              id="estadoVehiculo"
              name="estadoVehiculo"
              required
            )
              option(value="" selected disabled) Seleccionar estado...
              option Sin daños visibles
              option Con daños visibles

          .col-md-6
            label.form-label(for="observaciones") Observaciones
            input.form-control(
              type="text"
              id="observaciones"
              name="observaciones"
            )

          // CONTROL
          h5.text-info.mt-4.mb-3 Control del servicio

          .col-md-4
            label.form-label(for="fechaServicio") Fecha
            input.form-control(
              type="date"
              id="fechaServicio"
              name="fechaServicio"
              required
            )

          .col-md-4
            label.form-label(for="horaEntrada") Hora de entrada
            input.form-control(
              type="time"
              id="horaEntrada"
              name="horaEntrada"
              required
            )

          .col-md-4
            label.form-label(for="horaSalida") Hora de salida
            input.form-control(
              type="time"
              id="horaSalida"
              name="horaSalida"
            )

          // WHATSAPP
          h5.text-info.mt-4.mb-3 Notificación por WhatsApp

          .col-md-6
            .form-check.mt-2
              input.form-check-input(
                type="checkbox"
                id="notificarWhatsapp"
                name="notificarWhatsapp"
              )
              label.form-check-label(for="notificarWhatsapp")
                |Confirmo la informaciòn y enviar nptificaciòn

          .col-md-6
            label.form-label(for="mensajeWhatsapp") Mensaje personalizado
            input.form-control(
              type="text"
              id="mensajeWhatsapp"
              name="mensajeWhatsapp"
              placeholder="Ej: Su vehículo está listo"
            )


          // BOTON
          .col-12.text-center.mt-4
            button.btn.btn-success.px-5(type="submit")
              | Registrar servicio 
              